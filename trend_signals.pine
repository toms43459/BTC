//@version=6
indicator("趨勢訊號", shorttitle = "趨勢訊號", overlay = true, max_lines_count = 500, max_boxes_count = 100, max_labels_count = 500)

// ════════════════════════════════════════════════════════════════════
//  趨勢訊號 —— 長線方向過濾 + 日內回檔進場 + 支撐壓力 + 風險控管
//  • 長線（半年）方向：週線 / 日線 4 個條件，3 個以上成立偏多、1 個以下偏空
//  • 短線訊號：設計給 15 分 / 1 小時圖，所有條件同時成立才出訊號（少而準）
//  • 停損 / 停利 / 建議倉位與槓桿；同一天連虧達設定筆數即停止出訊號
//  • 支撐壓力判定沿用 support_resistance.pine
//  • 高週期資料只用已收盤的K棒（lookahead 關閉），不使用未來資料
//  • 回測請用同一套規則的 trend_strategy.pine
// ════════════════════════════════════════════════════════════════════

// ───────────────────────────── 輸入 ─────────────────────────────
const string G_LT  = "① 長線趨勢（週線 / 日線）"
const string G_MT  = "② 4 小時趨勢"
const string G_IN  = "③ 短線進場條件"
const string G_RK  = "④ 停損 / 停利 / 倉位"
const string G_LV  = "⑤ 支撐 / 壓力（沿用 support_resistance）"
const string G_STY = "⑥ 外觀"

const string EX_FIX   = "固定 R 倍數"
const string EX_TRAIL = "ATR 移動停損"
const string EX_BOTH  = "兩者皆用（先到先出）"

string tfW         = input.timeframe("W", "週線週期", group = G_LT)
int    wEmaLen     = input.int(50, "週線 EMA 長度", minval = 1, group = G_LT)
int    wSlopeBars  = input.int(4, "週線 EMA 斜率：與幾週前比較", minval = 1, group = G_LT)
int    wRsiLen     = input.int(14, "週線 RSI 長度", minval = 1, group = G_LT)
float  wRsiLvl     = input.float(50.0, "週線 RSI 多空分界", minval = 0, maxval = 100, group = G_LT)
string tfD         = input.timeframe("D", "日線週期", group = G_LT)
int    dFastLen    = input.int(50, "日線 EMA 快線", minval = 1, inline = "d", group = G_LT)
int    dSlowLen    = input.int(200, "慢線", minval = 1, inline = "d", group = G_LT)
int    bullNeed    = input.int(3, "偏多：成立條件數 ≥", minval = 1, maxval = 4, group = G_LT, tooltip = "4 個條件：週線收盤 > 週線 EMA、週線 EMA 比 N 週前高、日線 EMA 快線 > 慢線、週線 RSI > 分界。")
int    bearMax     = input.int(1, "偏空：成立條件數 ≤", minval = 0, maxval = 3, group = G_LT, tooltip = "介於偏多與偏空之間 = 中性。高週期資料不足時也視為中性。")

string tfH         = input.timeframe("240", "4 小時週期", group = G_MT)
int    hFastLen    = input.int(50, "4 小時 EMA 快線", minval = 1, inline = "h", group = G_MT)
int    hSlowLen    = input.int(200, "慢線", minval = 1, inline = "h", group = G_MT)
int    hAdxLen     = input.int(14, "4 小時 ADX 長度", minval = 1, group = G_MT)
float  hAdxClear   = input.float(25.0, "長線中性時，4 小時 ADX 需大於", minval = 0, group = G_MT, tooltip = "長線中性時，只在 4 小時趨勢很明確（ADX 高於此值）時才出訊號。")

int    emaLen      = input.int(21, "回檔 EMA 長度", minval = 1, group = G_IN)
float  pbAtr       = input.float(0.5, "回檔碰 EMA 距離 (ATR 倍數)", minval = 0, step = 0.1, group = G_IN, tooltip = "K棒高低點進入 EMA ± ATR × 此值的範圍，就算碰到 EMA 附近。")
int    pbLook      = input.int(5, "回檔有效K棒數", minval = 1, group = G_IN, tooltip = "最近 N 根K棒內（含本根）碰過 EMA 附近或支撐（做空：壓力），本根收盤重新站上（跌破）EMA 才算數。")
int    rsiLen      = input.int(14, "RSI 長度", minval = 1, group = G_IN)
float  rsiLvl      = input.float(50.0, "RSI 穿越值", minval = 0, maxval = 100, group = G_IN)
int    volLen      = input.int(20, "均量週期", minval = 1, group = G_IN)
float  sigVolMult  = input.float(1.3, "訊號成交量倍數", minval = 0, step = 0.1, group = G_IN, tooltip = "成交量 > 均量 × 此倍數。")
int    adxLen      = input.int(14, "ADX 長度", minval = 1, group = G_IN)
float  adxMin      = input.float(20.0, "ADX 需大於", minval = 0, group = G_IN, tooltip = "低於此值視為盤整，不出訊號。")
float  roomMult    = input.float(1.5, "前方強壓力 / 強支撐最小距離 (ATR 倍數)", minval = 0, step = 0.1, group = G_IN, tooltip = "做多：上方最近的強壓力距離需大於 ATR × 此值；做空：下方最近的強支撐。")
bool   roomStrong  = input.bool(true, "只計算強壓力 / 強支撐", group = G_IN, tooltip = "關閉後，一般壓力 / 支撐也算。")
int    coolBars    = input.int(10, "同方向訊號最少間隔K棒", minval = 1, group = G_IN, tooltip = "出一個訊號後，這麼多根K棒內不再出同方向訊號。")
int    strongLook  = input.int(1, "「強」：帶量突破 / 支撐反彈 出現在最近幾根K棒", minval = 1, group = G_IN, tooltip = "1 = 與訊號同一根K棒。做空對應帶量跌破 / 壓力回落。")

int    atrLen      = input.int(14, "ATR 週期", minval = 1, group = G_RK)
float  slAtr       = input.float(1.5, "停損：ATR 倍數", minval = 0.1, step = 0.1, group = G_RK)
int    swingLen    = input.int(10, "停損：波段高低點回看K棒數", minval = 1, group = G_RK)
float  swingBuf    = input.float(0.1, "停損：波段外側緩衝 (ATR 倍數)", minval = 0, step = 0.05, group = G_RK)
float  slMinAtr    = input.float(1.0, "停損：最小距離 (ATR 倍數)", minval = 0, step = 0.1, group = G_RK, tooltip = "ATR 停損與波段外側停損取較近者，但距離不小於 ATR × 此值。")
float  tp1R        = input.float(1.5, "停利 1 (R 倍數)", minval = 0.1, step = 0.1, group = G_RK)
float  tp1Pct      = input.float(50.0, "停利 1 出場比例 %", minval = 1, maxval = 100, group = G_RK)
float  tp2R        = input.float(3.0, "停利 2 (R 倍數)", minval = 0.1, step = 0.1, group = G_RK)
string exitMode    = input.string(EX_FIX, "剩餘部位出場方式", options = [EX_FIX, EX_TRAIL, EX_BOTH], group = G_RK)
float  trailAtr    = input.float(2.0, "移動停損 ATR 倍數", minval = 0.1, step = 0.1, group = G_RK, tooltip = "停利 1 之後啟動：持倉期間最高價（做空：最低價）回落 ATR × 此值即出場，停損只會往有利方向移動。")
float  capital     = input.float(10000.0, "本金", minval = 1, group = G_RK, tooltip = "用來計算建議倉位與槓桿。")
float  riskPct     = input.float(5.0, "每筆風險 %（本金）", minval = 0.1, step = 0.5, group = G_RK)
float  maxLev      = input.float(5.0, "槓桿上限", minval = 1, step = 0.5, group = G_RK, tooltip = "依風險算出的倉位超過此槓桿時，倉位縮到上限，實際風險會小於設定。")
int    maxLoss     = input.int(2, "同一天連虧幾筆後停止出訊號", minval = 1, group = G_RK)
string dayTz       = input.string("UTC+8", "「同一天」使用的時區", group = G_RK, tooltip = "例如 UTC+8（台灣）、UTC。每天 00:00 連虧次數歸零。")

int    pivotLen    = input.int(10, "前高 / 前低 左右K棒數", minval = 2, group = G_LV, tooltip = "轉折高點(低點)左右兩側各需幾根K棒比它低(高)。數字越大，價位越少、越重要。")
int    strongTouch = input.int(3, "強支撐 / 強壓力 觸碰次數", minval = 2, group = G_LV)
float  mergeMult   = input.float(1.0, "同一價位合併距離 (ATR 倍數)", minval = 0.1, step = 0.1, group = G_LV)
float  zoneMult    = input.float(0.3, "區間寬度 (ATR 倍數)", minval = 0.0, step = 0.05, group = G_LV)
float  volMult     = input.float(1.5, "帶量突破倍數", minval = 1.0, step = 0.1, group = G_LV, tooltip = "突破K棒的成交量 ≥ 均量 × 此倍數，才算「帶量突破 / 帶量跌破」。")
int    fakeBars    = input.int(3, "假突破判定K棒數", minval = 1, group = G_LV)
int    coolDown    = input.int(5, "反彈 / 回落 訊號最少間隔K棒", minval = 1, group = G_LV)
bool   showLevels  = input.bool(true, "畫出支撐 / 壓力", group = G_LV)
int    perSide     = input.int(3, "上下各顯示幾條", minval = 1, maxval = 15, group = G_LV)
int    lblOffset   = input.int(5, "價位標籤右移K棒數", minval = 0, maxval = 100, group = G_LV)

color  bullCol     = input.color(#00c853, "做多", inline = "c1", group = G_STY)
color  bearCol     = input.color(#ff1744, "做空", inline = "c1", group = G_STY)
color  emaCol      = input.color(#ffb300, "EMA", inline = "c1", group = G_STY)
color  slCol       = input.color(#f23645, "停損線", inline = "c2", group = G_STY)
color  tpCol       = input.color(#089981, "停利線", inline = "c2", group = G_STY)
color  entryCol    = input.color(#9598a1, "進場線", inline = "c2", group = G_STY)
color  supCol      = input.color(#089981, "支撐", inline = "c3", group = G_STY)
color  resCol      = input.color(#f23645, "壓力", inline = "c3", group = G_STY)
color  bgBullCol   = input.color(#00c853, "長線偏多背景", inline = "c4", group = G_STY)
color  bgBearCol   = input.color(#ff1744, "長線偏空背景", inline = "c4", group = G_STY)
int    bgTransp    = input.int(92, "背景透明度", minval = 0, maxval = 100, group = G_STY)
string sigSizeIn   = input.string("大", "訊號文字大小", options = ["小", "中", "大", "特大"], group = G_STY)
string tblSizeIn   = input.string("中", "表格文字大小", options = ["小", "中", "大", "特大"], group = G_STY)
bool   showEma     = input.bool(true, "顯示回檔 EMA", group = G_STY)
bool   showLines   = input.bool(true, "訊號出現時畫出進場 / 停損 / 停利線", group = G_STY)
bool   showResult  = input.bool(true, "標示每筆出場結果 (R)", group = G_STY)

// ─────────────────────────── 型別與函式 ───────────────────────────
type Level
    float price
    int   touches  = 1
    bool  isRes    = false
    int   startBar
    int   lastBar
    int   breakDir = 0    // 1 = 剛帶量突破，-1 = 剛帶量跌破（用於判定假突破 / 假跌破）
    int   breakBar = 0

toSize(string s) =>
    switch s
        "小" => size.small
        "中" => size.normal
        "大" => size.large
        => size.huge

// 依位置與觸碰次數命名：強支撐 / 支撐 / 強壓力 / 壓力
lvName(bool isRes, int touches) =>
    string base = isRes ? "壓力" : "支撐"
    touches >= strongTouch ? "強" + base : base

addLine(string a, string b) =>
    a == "" ? b : a + "\n" + b

fmt(float p) =>
    str.tostring(p, format.mintick)

// 在高週期資料上計算：[收盤, 快線 EMA, N 根前的快線, 慢線 EMA, RSI, ADX]
// 搭配 lookahead 關閉使用，確保只拿「已收盤」的高週期K棒：
//  • 歷史K棒：高週期K棒收盤的那一根才換新值，呼叫端再往前取一根 → 整段期間都是上一根已收盤的高週期K棒
//  • 即時K棒：在高週期這邊直接取前一根 → 同樣是上一根已收盤的高週期K棒
//  歷史與即時一致，不偷看未來、不重繪
htfCalc(simple int fastLen, simple int slowLen, simple int slopeBars, simple int rsiN, simple int adxN) =>
    int   o  = barstate.isrealtime ? 1 : 0
    float ef = ta.ema(close, fastLen)
    float es = ta.ema(close, slowLen)
    float r  = ta.rsi(close, rsiN)
    [dp, dm, a] = ta.dmi(adxN, adxN)
    [close[o], ef[o], ef[o + slopeBars], es[o], r[o], a[o]]

// ─────────────────────────── 高週期趨勢 ───────────────────────────
[wC, wE, wEp, wEs, wR, wA] = request.security(syminfo.tickerid, tfW, htfCalc(wEmaLen, wEmaLen, wSlopeBars, wRsiLen, hAdxLen), lookahead = barmerge.lookahead_off)
[dC, dE, dEp, dEs, dR, dA] = request.security(syminfo.tickerid, tfD, htfCalc(dFastLen, dSlowLen, 1, wRsiLen, hAdxLen), lookahead = barmerge.lookahead_off)
[hC, hE, hEp, hEs, hR, hA] = request.security(syminfo.tickerid, tfH, htfCalc(hFastLen, hSlowLen, 1, wRsiLen, hAdxLen), lookahead = barmerge.lookahead_off)

int   ro      = barstate.isrealtime ? 0 : 1    // 歷史K棒往前取一根（見 htfCalc 說明）
float wClose  = wC[ro]
float wEma    = wE[ro]
float wEmaPv  = wEp[ro]
float wRsi    = wR[ro]
float dFast   = dE[ro]
float dSlow   = dEs[ro]
float hFast   = hE[ro]
float hSlow   = hEs[ro]
float hAdx    = hA[ro]

// 長線（半年）：4 個條件計分
bool  wReady  = not na(wClose) and not na(wEma) and not na(wEmaPv) and not na(wRsi)
bool  dReady  = not na(dFast) and not na(dSlow)
bool  ltReady = wReady and dReady
bool  c1      = wClose > wEma       // 週線收盤 > 週線 EMA50
bool  c2      = wEma > wEmaPv       // 週線 EMA50 比 4 週前高
bool  c3      = dFast > dSlow       // 日線 EMA50 > EMA200
bool  c4      = wRsi > wRsiLvl      // 週線 RSI > 50
int   ltScore = (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0)
int   ltDir   = not ltReady ? 0 : ltScore >= bullNeed ? 1 : ltScore <= bearMax ? -1 : 0

// 4 小時：EMA50 / EMA200 方向，ADX 判斷是否明確
bool  hReady  = not na(hFast) and not na(hSlow) and not na(hAdx)
bool  hBull   = hReady and hFast > hSlow
bool  hBear   = hReady and hFast < hSlow
bool  hClear  = hReady and hAdx > hAdxClear
bool  allowL  = hBull and ltDir != -1 and (ltDir == 1 or hClear)
bool  allowS  = hBear and ltDir != 1 and (ltDir == -1 or hClear)

// ─────────────────────────── 基礎數值 ───────────────────────────
float atr     = ta.atr(atrLen)
float vol     = nz(volume)
float volMA   = ta.sma(vol, volLen)
bool  hasVol  = not na(volMA) and volMA > 0
bool  volOK   = not hasVol or vol >= volMA * volMult
float z       = nz(atr) * zoneMult / 2
bool  canSig  = barstate.isconfirmed

// 實體突破：實體至少佔整根K棒一半（排除長影線的假動作）
float rng       = high - low
bool  bullBody  = close > open and close - open >= rng * 0.5
bool  bearBody  = close < open and open - close >= rng * 0.5

// 止跌 / 止漲 K棒型態（長影線 / 吞噬 / 量縮）
float lowerWick = math.min(open, close) - low
float upperWick = high - math.max(open, close)
bool  longLower = rng > 0 and lowerWick >= rng * 0.5
bool  longUpper = rng > 0 and upperWick >= rng * 0.5
bool  bullEng   = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bool  bearEng   = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
bool  dryBull   = hasVol and vol < volMA and close > open and low >= low[1]
bool  dryBear   = hasVol and vol < volMA and close < open and high <= high[1]
bool  bullStop  = longLower or bullEng or dryBull
bool  bearStop  = longUpper or bearEng or dryBear

// ─────────────────────────── 支撐 / 壓力追蹤（沿用 support_resistance.pine） ───────────────────────────
const int MAX_LEVELS = 40
var array<Level> levels = array.new<Level>()
var int lastBounce = -1000000
var int lastReject = -1000000

bool sigBreakUp  = false   // 帶量突破
bool sigBreakDn  = false   // 帶量跌破
bool sigBounce   = false   // 支撐反彈
bool sigReject   = false   // 壓力回落
bool bounceReady = bar_index - lastBounce > coolDown
bool rejectReady = bar_index - lastReject > coolDown

if not na(atr)
    for lv in levels
        float top  = lv.price + z
        float bot  = lv.price - z
        bool  done = false

        // ① 假突破 / 假跌破：帶量突破(跌破)後 N 根K棒內收盤又回到另一側 → 角色改回（本指標不另外標示）
        if lv.breakDir != 0
            int age = bar_index - lv.breakBar
            if age > fakeBars
                lv.breakDir := 0
            else if age > 0 and lv.breakDir == 1 and close < lv.price
                lv.breakDir := 0
                lv.isRes    := true
                done        := true
            else if age > 0 and lv.breakDir == -1 and close > lv.price
                lv.breakDir := 0
                lv.isRes    := false
                done        := true

        if not done
            // ② 收盤價超出區間 → 角色互換；帶量 + 實體K棒才算「帶量突破 / 帶量跌破」
            if lv.isRes and close > top
                lv.isRes := false
                if volOK and bullBody
                    lv.breakDir := 1
                    lv.breakBar := bar_index
                    if canSig
                        sigBreakUp := true
            else if not lv.isRes and close < bot
                lv.isRes := true
                if volOK and bearBody
                    lv.breakDir := -1
                    lv.breakBar := bar_index
                    if canSig
                        sigBreakDn := true
            // ③ 回測支撐並出現止跌K棒 → 支撐反彈；反彈到壓力並出現止漲K棒 → 壓力回落
            else if not lv.isRes and low <= top and close > lv.price and bullStop and bounceReady and math.min(low[2], low[3]) > top
                if canSig
                    sigBounce := true
            else if lv.isRes and high >= bot and close < lv.price and bearStop and rejectReady and math.max(high[2], high[3]) < bot
                if canSig
                    sigReject := true

if sigBounce
    lastBounce := bar_index
if sigReject
    lastReject := bar_index

// 新的前高 / 前低：靠近既有價位就合併（觸碰 +1），否則新增
addLevel(float p, int pBar) =>
    int   idx  = -1
    float best = atr * mergeMult
    for [i, lv] in levels
        float d = math.abs(lv.price - p)
        if d <= best
            best := d
            idx  := i
    if idx >= 0
        Level hit = levels.get(idx)
        hit.price   := (hit.price * hit.touches + p) / (hit.touches + 1)
        hit.touches := hit.touches + 1
        hit.lastBar := pBar
    else
        levels.push(Level.new(price = p, isRes = close < p, startBar = pBar, lastBar = pBar))
        if levels.size() > MAX_LEVELS
            int old = 0
            for i = 1 to levels.size() - 1
                if levels.get(i).lastBar < levels.get(old).lastBar
                    old := i
            levels.remove(old)
    idx

float ph = ta.pivothigh(high, pivotLen, pivotLen)
float pl = ta.pivotlow(low, pivotLen, pivotLen)

if not na(atr)
    if not na(ph)
        addLevel(ph, bar_index - pivotLen)
    if not na(pl)
        addLevel(pl, bar_index - pivotLen)

// 本根K棒是否碰到支撐 / 壓力區間，以及前方最近的（強）壓力 / 支撐距離
bool  touchSup = false
bool  touchRes = false
float resGap   = na
float supGap   = na
if not na(atr)
    for lv in levels
        if low <= lv.price + z and high >= lv.price - z
            if lv.isRes
                touchRes := true
            else
                touchSup := true
        if not roomStrong or lv.touches >= strongTouch
            float g = lv.isRes ? lv.price - close : close - lv.price
            if g > -z    // 排除剛合併、角色要到下一根K棒才更新的價位
                if lv.isRes
                    resGap := na(resGap) ? g : math.min(resGap, g)
                else
                    supGap := na(supGap) ? g : math.min(supGap, g)

// ─────────────────────────── 短線進場條件 ───────────────────────────
float emaF    = ta.ema(close, emaLen)
float rsi     = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
bool  rsiUp   = ta.crossover(rsi, rsiLvl)
bool  rsiDn   = ta.crossunder(rsi, rsiLvl)
float pbDist  = nz(atr) * pbAtr
bool  nearEma = low <= emaF + pbDist and high >= emaF - pbDist
int   sinceL  = ta.barssince(nearEma or touchSup)
int   sinceS  = ta.barssince(nearEma or touchRes)
bool  pullL   = nz(sinceL, pbLook) < pbLook and close > emaF     // 回檔碰 EMA 附近或支撐後，收盤重新站上 EMA
bool  pullS   = nz(sinceS, pbLook) < pbLook and close < emaF     // 反彈碰 EMA 附近或壓力後，收盤重新跌破 EMA
bool  volSig  = not hasVol or vol > volMA * sigVolMult
bool  adxOK   = adx > adxMin
bool  roomL   = na(resGap) or resGap > roomMult * atr
bool  roomS   = na(supGap) or supGap > roomMult * atr
bool  setupL  = allowL and pullL and rsiUp and volSig and adxOK and roomL
bool  setupS  = allowS and pullS and rsiDn and volSig and adxOK and roomS

// 現有指標的帶量突破 / 支撐反彈（做空：帶量跌破 / 壓力回落）同時出現 → 標籤加註「強」
int   sinceBullSR = ta.barssince(sigBreakUp or sigBounce)
int   sinceBearSR = ta.barssince(sigBreakDn or sigReject)
bool  strongL     = nz(sinceBullSR, strongLook) < strongLook
bool  strongS     = nz(sinceBearSR, strongLook) < strongLook

// 停損距離：1.5 ATR 與波段低點(高點)外側取較近者，但不小於 1 ATR
float swLo    = ta.lowest(low, swingLen)
float swHi    = ta.highest(high, swingLen)
float slDistL = math.max(math.min(slAtr * atr, close - (swLo - swingBuf * atr)), slMinAtr * atr)
float slDistS = math.max(math.min(slAtr * atr, swHi + swingBuf * atr - close), slMinAtr * atr)

// 每日歸零（依設定時區）
int   dayKey  = year(time, dayTz) * 10000 + month(time, dayTz) * 100 + dayofmonth(time, dayTz)
bool  newDay  = dayKey != dayKey[1]

// ─────────────────────────── 交易模擬（停損 / 停利 / 連虧） ───────────────────────────
// 與 trend_strategy.pine 同一套出場規則，用來畫線、算連虧與顯示表格
bool useTp2   = exitMode != EX_TRAIL
bool useTrail = exitMode != EX_FIX

var int    tDir       = 0        // 1 = 做多中，-1 = 做空中，0 = 空手
var int    tBar       = 0
var bool   tStrong    = false
var float  tEntry     = na
var float  tRisk      = na       // 1R = 進場到停損的距離
var float  tAtr       = na
var float  tInitSL    = na
var float  tStop      = na       // 目前停損（停利 1 之後可能移動）
var float  tTp1       = na
var float  tTp2       = na
var float  tPeak      = na
var bool   tTp1Hit    = false
var float  tLeft      = 0.0      // 剩餘部位比例
var float  tPnlR      = 0.0      // 已實現損益（R）
var float  tQty       = na
var float  tLev       = na
var float  tRealRk    = na       // 實際風險 %（受槓桿上限時會小於設定）
var string lastRes    = ""
var int    lossStreak = 0
var int    lastLongBar  = -1000000
var int    lastShortBar = -1000000

var line   lnEntry = na
var line   lnSL    = na
var line   lnTp1   = na
var line   lnTp2   = na
var label  lbEntry = na
var label  lbSL    = na
var label  lbTp1   = na
var label  lbTp2   = na

if newDay
    lossStreak := 0

bool   tradeEnd = false
string exitTxt  = ""
if tDir != 0 and bar_index > tBar
    int   d        = tDir
    float fav      = d == 1 ? high : low
    float adv      = d == 1 ? low : high
    // 與 TradingView 回測相同的K棒內路徑假設：開盤較接近高點 → 開→高→低→收，否則 開→低→高→收
    bool  hiFirst  = high - open < open - low
    bool  favFirst = d == 1 ? hiFirst : not hiFirst
    bool  stopHit  = d * (adv - tStop) <= 0
    bool  tp1Can   = not tTp1Hit and d * (fav - tTp1) >= 0
    bool  tp2Can   = useTp2 and d * (fav - tTp2) >= 0
    string stopNm  = tTp1Hit and useTrail ? "移動停損" : "停損"
    if d * (open - tStop) <= 0
        // 開盤直接跳過停損 → 以開盤價出場
        tPnlR   += tLeft * d * (open - tEntry) / tRisk
        tLeft   := 0.0
        exitTxt := stopNm
    else if not favFirst and stopHit
        tPnlR   += tLeft * d * (tStop - tEntry) / tRisk
        tLeft   := 0.0
        exitTxt := stopNm
    else
        if tp1Can
            float px = d == 1 ? math.max(open, tTp1) : math.min(open, tTp1)
            float q  = math.min(tLeft, tp1Pct / 100)
            tPnlR   += q * d * (px - tEntry) / tRisk
            tLeft   -= q
            tTp1Hit := true
            exitTxt := "停利1"
        if tTp1Hit and tp2Can and tLeft > 0
            float px = d == 1 ? math.max(open, tTp2) : math.min(open, tTp2)
            tPnlR   += tLeft * d * (px - tEntry) / tRisk
            tLeft   := 0.0
            exitTxt := "停利2"
        if tLeft > 0 and stopHit
            tPnlR   += tLeft * d * (tStop - tEntry) / tRisk
            tLeft   := 0.0
            exitTxt := stopNm

    if tLeft <= 0
        tradeEnd   := true
        lossStreak := tPnlR < 0 ? lossStreak + 1 : 0
        lastRes    := (d == 1 ? "做多 " : "做空 ") + exitTxt + " " + (tPnlR >= 0 ? "+" : "") + str.tostring(tPnlR, "0.00") + "R"
        tDir       := 0
    else
        // 停利 1 之後：剩餘部位用 ATR 移動停損（只往有利方向移動）
        tPeak := d == 1 ? math.max(tPeak, high) : math.min(tPeak, low)
        if tTp1Hit and useTrail
            float tr = tPeak - d * trailAtr * atr
            tStop := d == 1 ? math.max(tStop, tr) : math.min(tStop, tr)

// 持倉中的線段延伸到目前K棒
if showLines and (tDir != 0 or tradeEnd)
    lnEntry.set_x2(bar_index)
    lnSL.set_x2(bar_index)
    lnTp1.set_x2(bar_index)
    lbEntry.set_x(bar_index)
    lbSL.set_x(bar_index)
    lbTp1.set_x(bar_index)
    if not na(lnTp2)
        lnTp2.set_x2(bar_index)
        lbTp2.set_x(bar_index)

if tradeEnd and showResult
    bool win = tPnlR >= 0
    label.new(bar_index, high, exitTxt + " " + (win ? "+" : "") + str.tostring(tPnlR, "0.00") + "R", yloc = yloc.abovebar, color = color.new(win ? tpCol : slCol, 25), style = label.style_label_down, textcolor = color.white, size = size.small)

// ─────────────────────────── 訊號 ───────────────────────────
bool locked   = lossStreak >= maxLoss
bool canTrade = canSig and tDir == 0 and not locked and atr > 0
bool sigL     = canTrade and setupL and bar_index - lastLongBar > coolBars
bool sigS     = canTrade and setupS and bar_index - lastShortBar > coolBars

string baseCcy = syminfo.basecurrency != "" ? syminfo.basecurrency : "單位"
string sigTxt  = ""
string sigTip  = ""
if sigL or sigS
    int   d    = sigL ? 1 : -1
    float dist = d == 1 ? slDistL : slDistS
    tDir    := d
    tBar    := bar_index
    tStrong := d == 1 ? strongL : strongS
    tEntry  := close
    tRisk   := dist
    tAtr    := atr
    tInitSL := close - d * dist
    tStop   := tInitSL
    tTp1    := close + d * tp1R * dist
    tTp2    := close + d * tp2R * dist
    tPeak   := close
    tTp1Hit := false
    tLeft   := 1.0
    tPnlR   := 0.0

    // 建議倉位 = 本金 × 風險% ÷ 停損距離；換算槓桿，超過上限就縮倉
    float q   = capital * riskPct / 100 / dist
    float lev = q * close / capital
    if lev > maxLev
        q   := capital * maxLev / close
        lev := maxLev
    tQty    := q
    tLev    := lev
    tRealRk := q * dist / capital * 100

    if d == 1
        lastLongBar := bar_index
    else
        lastShortBar := bar_index

    sigTxt := (d == 1 ? "▲ 做多" : "▼ 做空") + (tStrong ? "（強）" : "")
    sigTip := "進場 " + fmt(tEntry) + "\n停損 " + fmt(tInitSL) + "\n停利1 " + fmt(tTp1) + "（" + str.tostring(tp1R) + "R）" + "\n停利2 " + (useTp2 ? fmt(tTp2) + "（" + str.tostring(tp2R) + "R）" : "ATR 移動停損") + "\n建議倉位 " + str.tostring(tQty, "#.####") + " " + baseCcy + "\n建議槓桿 " + str.tostring(tLev, "0.0") + "x"
    if tStrong
        sigTip := addLine(sigTip, d == 1 ? "同時出現：帶量突破 / 支撐反彈" : "同時出現：帶量跌破 / 壓力回落")

    if showLines
        lnEntry := line.new(bar_index, tEntry, bar_index, tEntry, color = entryCol, style = line.style_dotted, width = 1)
        lnSL    := line.new(bar_index, tInitSL, bar_index, tInitSL, color = slCol, style = line.style_solid, width = 2)
        lnTp1   := line.new(bar_index, tTp1, bar_index, tTp1, color = tpCol, style = line.style_dashed, width = 2)
        lbEntry := label.new(bar_index, tEntry, "進場 " + fmt(tEntry), style = label.style_label_left, color = color.new(entryCol, 30), textcolor = color.white, size = size.small)
        lbSL    := label.new(bar_index, tInitSL, "停損 " + fmt(tInitSL), style = label.style_label_left, color = color.new(slCol, 20), textcolor = color.white, size = size.small)
        lbTp1   := label.new(bar_index, tTp1, "停利1 " + fmt(tTp1), style = label.style_label_left, color = color.new(tpCol, 20), textcolor = color.white, size = size.small)
        if useTp2
            lnTp2 := line.new(bar_index, tTp2, bar_index, tTp2, color = tpCol, style = line.style_solid, width = 2)
            lbTp2 := label.new(bar_index, tTp2, "停利2 " + fmt(tTp2), style = label.style_label_left, color = color.new(tpCol, 20), textcolor = color.white, size = size.small)
        else
            lnTp2 := na
            lbTp2 := na

string sigSize = toSize(sigSizeIn)
if sigL
    label.new(bar_index, low, sigTxt, yloc = yloc.belowbar, color = bullCol, style = label.style_label_up, textcolor = color.white, size = sigSize, tooltip = sigTip, text_formatting = text.format_bold)
if sigS
    label.new(bar_index, high, sigTxt, yloc = yloc.abovebar, color = bearCol, style = label.style_label_down, textcolor = color.white, size = sigSize, tooltip = sigTip, text_formatting = text.format_bold)

// ─────────────────────────── 支撐 / 壓力畫線 ───────────────────────────
var array<line>  lvLines  = array.new<line>()
var array<box>   lvBoxes  = array.new<box>()
var array<label> lvLabels = array.new<label>()

drawLevel(Level lv) =>
    bool   strong = lv.touches >= strongTouch
    color  c      = lv.isRes ? resCol : supCol
    int    x1     = math.max(lv.startBar, bar_index - 4900)
    int    x2     = bar_index + lblOffset
    string txt    = lvName(lv.isRes, lv.touches) + "  " + fmt(lv.price)
    string tip    = "觸碰次數：" + str.tostring(lv.touches) + "\n區間：" + fmt(lv.price - z) + " ~ " + fmt(lv.price + z)
    lvLines.push(line.new(x1, lv.price, x2, lv.price, color = color.new(c, 30), width = strong ? 2 : 1, style = strong ? line.style_solid : line.style_dashed))
    if z > 0
        lvBoxes.push(box.new(x1, lv.price + z, x2, lv.price - z, border_color = color.new(c, 100), border_width = 0, bgcolor = color.new(c, strong ? 82 : 92)))
    lvLabels.push(label.new(x2, lv.price, txt, color = color.new(c, strong ? 10 : 40), style = label.style_label_left, textcolor = color.white, size = size.small, tooltip = tip))
    strong

// 只在最後一根K棒重畫：上下各取離現價最近的 N 條
if barstate.islast and showLevels
    for l in lvLines
        l.delete()
    for b in lvBoxes
        b.delete()
    for lb in lvLabels
        lb.delete()
    lvLines.clear()
    lvBoxes.clear()
    lvLabels.clear()

    array<Level> sups = array.new<Level>()
    array<float> supD = array.new<float>()
    array<Level> ress = array.new<Level>()
    array<float> resD = array.new<float>()
    for lv in levels
        float d = math.abs(close - lv.price)
        if lv.isRes
            ress.push(lv)
            resD.push(d)
        else
            sups.push(lv)
            supD.push(d)
    if sups.size() > 0
        array<int> near = supD.sort_indices(order.ascending)
        for k = 0 to math.min(perSide, sups.size()) - 1
            drawLevel(sups.get(near.get(k)))
    if ress.size() > 0
        array<int> near = resD.sort_indices(order.ascending)
        for k = 0 to math.min(perSide, ress.size()) - 1
            drawLevel(ress.get(near.get(k)))

// ─────────────────────────── 圖表 ───────────────────────────
bgcolor(ltDir == 1 ? color.new(bgBullCol, bgTransp) : ltDir == -1 ? color.new(bgBearCol, bgTransp) : na, title = "長線背景")
plot(showEma ? emaF : na, "回檔 EMA", color = emaCol, linewidth = 1)
plot(tDir != 0 and tTp1Hit and useTrail ? tStop : na, "移動停損", color = slCol, style = plot.style_linebr, linewidth = 2)
plot(ltScore, "長線分數", display = display.data_window)
plot(hAdx, "4 小時 ADX", display = display.data_window)
plot(adx, "ADX", display = display.data_window)
plot(hasVol ? vol / volMA : na, "量比", display = display.data_window)

// ─────────────────────────── 右上角表格 ───────────────────────────
var table tb = table.new(position.top_right, 2, 14, bgcolor = color.new(#131722, 15), frame_color = color.new(#787b86, 40), frame_width = 1, border_color = color.new(#787b86, 75), border_width = 1)

dirColor(int d) =>
    d == 1 ? bullCol : d == -1 ? bearCol : color.silver

setRow(int r, string k, string v, color c) =>
    string sz = toSize(tblSizeIn)
    tb.cell(0, r, k, text_color = color.white, text_halign = text.align_left, text_size = sz)
    tb.cell(1, r, v, text_color = c, text_halign = text.align_left, text_size = sz)

if barstate.islast
    setRow(0, "趨勢訊號", syminfo.ticker + " · " + timeframe.period, color.white)

    string ltTxt = not ltReady ? "資料不足（視為中性）" : (ltDir == 1 ? "偏多" : ltDir == -1 ? "偏空" : "中性") + "（" + str.tostring(ltScore) + " / 4 成立）"
    setRow(1, "長線（半年）", ltTxt, dirColor(ltDir))

    int    wDir = not wReady ? 0 : c1 and c2 ? 1 : not c1 and not c2 ? -1 : 0
    string wTxt = not wReady ? "資料不足" : (wDir == 1 ? "偏多" : wDir == -1 ? "偏空" : "盤整") + "（收盤" + (c1 ? "在" : "跌破") + " EMA" + str.tostring(wEmaLen) + "，EMA " + (c2 ? "向上" : "向下") + "，RSI " + str.tostring(wRsi, "0.0") + "）"
    setRow(2, "週線趨勢", wTxt, dirColor(wDir))

    string dTxt = not dReady ? "資料不足" : (c3 ? "多頭" : "空頭") + "（EMA" + str.tostring(dFastLen) + (c3 ? " > " : " < ") + "EMA" + str.tostring(dSlowLen) + "）"
    setRow(3, "日線趨勢", dTxt, dirColor(not dReady ? 0 : c3 ? 1 : -1))

    string hTxt = not hReady ? "資料不足" : (hBull ? "多頭" : hBear ? "空頭" : "持平") + "（ADX " + str.tostring(hAdx, "0.0") + (hClear ? "，明確" : "") + "）"
    setRow(4, "4 小時趨勢", hTxt, dirColor(hBull ? 1 : hBear ? -1 : 0))

    string biasTxt = locked ? "觀望（今日已連虧 " + str.tostring(lossStreak) + " 筆，停止出訊號）" : allowL ? "多" : allowS ? "空" : "觀望"
    setRow(5, "今日偏向", biasTxt, dirColor(locked ? 0 : allowL ? 1 : allowS ? -1 : 0))
    setRow(6, "今日連虧", str.tostring(lossStreak) + " / " + str.tostring(maxLoss) + " 筆", lossStreak > 0 ? bearCol : color.silver)

    bool   hasT   = not na(tEntry)
    bool   live   = tDir != 0
    string nowTxt = live ? (tDir == 1 ? "▲ 做多" : "▼ 做空") + (tStrong ? "（強）" : "") + (tTp1Hit ? " · 已達停利1" : " · 持倉中") : "無" + (lastRes != "" ? "（上一筆：" + lastRes + "）" : "")
    setRow(7, "目前訊號", nowTxt, dirColor(tDir))

    string prevTag = live ? "" : "（上一筆）"
    setRow(8, "進場價", hasT ? fmt(tEntry) + prevTag : "—", color.white)
    string slTxt = not hasT ? "—" : tStop != tInitSL ? fmt(tStop) + "（移動停損）" : fmt(tStop) + "（" + str.tostring(tRisk / tEntry * 100, "0.00") + "%，" + str.tostring(tRisk / tAtr, "0.0") + " ATR）"
    setRow(9, "停損", slTxt + (hasT ? prevTag : ""), slCol)
    setRow(10, "停利 1", hasT ? fmt(tTp1) + "（" + str.tostring(tp1R) + "R，出 " + str.tostring(tp1Pct) + "%）" + prevTag : "—", tpCol)
    string tp2Txt = exitMode == EX_TRAIL ? "剩餘部位用 ATR 移動停損" : fmt(tTp2) + "（" + str.tostring(tp2R) + "R" + (exitMode == EX_BOTH ? "，或移動停損" : "") + "）"
    setRow(11, "停利 2", hasT ? tp2Txt + prevTag : "—", tpCol)
    string qtyTxt = hasT ? str.tostring(tQty, "#.####") + " " + baseCcy + "（≈ " + str.tostring(tQty * tEntry, "#,##0") + " " + syminfo.currency + "）" : "—"
    setRow(12, "建議倉位", qtyTxt, color.white)
    string levTxt = hasT ? str.tostring(tLev, "0.0") + "x（上限 " + str.tostring(maxLev) + "x，風險 " + str.tostring(tRealRk, "0.0") + "%）" : "—"
    setRow(13, "建議槓桿", levTxt, color.white)

// ─────────────────────────── 警報 ───────────────────────────
alertcondition(sigL, "做多訊號", "{{ticker}} {{interval}}：▲ 做多，收盤 {{close}}")
alertcondition(sigS, "做空訊號", "{{ticker}} {{interval}}：▼ 做空，收盤 {{close}}")
// 建立警報時選「任何 alert() 函式呼叫」，訊息會附上停損 / 停利 / 倉位
if sigL or sigS
    alert(syminfo.ticker + " " + timeframe.period + "：" + sigTxt + "\n" + sigTip, alert.freq_once_per_bar_close)
