//@version=6
indicator("4H 趨勢突破", shorttitle = "4H 突破", overlay = true, max_labels_count = 500)

// ════════════════════════════════════════════════════════════════════
//  4H 趨勢突破 —— 4 小時圖專用的簡化趨勢跟隨（看盤用）
//  • 方向：日線 EMA50 > EMA200 只做多；EMA50 < EMA200 只做空
//    （日線資料 lookahead 關閉、只用已收盤的日K）
//  • 進場：收盤突破前 20 根K棒最高點（做空：跌破最低點），且成交量 > 20 根均量
//  • 出場：初始停損 2 ATR → 3 ATR 移動停損（只往有利方向移動），不設固定停利；
//    日線 EMA 交叉、方向反轉時也平倉
//  • 一次只持有一筆；倉位 = 本金 × 風險% ÷ 停損距離，槓桿上限 3 倍
//  • 回測請用規則完全相同的 trend4h_strategy.pine
// ════════════════════════════════════════════════════════════════════

// ───────────────────────────── 輸入 ─────────────────────────────
const string G_TR  = "① 日線趨勢"
const string G_IN  = "② 突破進場"
const string G_RK  = "③ 停損 / 倉位"
const string G_STY = "④ 外觀"

string tfD       = input.timeframe("D", "日線週期", group = G_TR)
int    dFastLen  = input.int(50, "日線 EMA 快線", minval = 1, inline = "d", group = G_TR)
int    dSlowLen  = input.int(200, "慢線", minval = 1, inline = "d", group = G_TR)

int    brkLen    = input.int(20, "突破回看K棒數", minval = 1, group = G_IN, tooltip = "收盤價突破前 N 根K棒（不含本根）的最高點做多、跌破最低點做空。")
int    volLen    = input.int(20, "均量週期", minval = 1, group = G_IN)
float  volMult   = input.float(1.0, "成交量倍數", minval = 0, step = 0.1, group = G_IN, tooltip = "突破K棒的成交量 > 均量 × 此倍數。")

int    atrLen    = input.int(14, "ATR 週期", minval = 1, group = G_RK)
float  slAtr     = input.float(2.0, "初始停損 (ATR 倍數)", minval = 0.1, step = 0.1, group = G_RK)
float  trailAtr  = input.float(3.0, "移動停損 (ATR 倍數)", minval = 0.1, step = 0.1, group = G_RK, tooltip = "持倉期間最高價（做空：最低價）回落 ATR × 此值。停損只會往有利方向移動，且不會比初始停損更遠。")
float  capital   = input.float(10000.0, "本金", minval = 1, group = G_RK, tooltip = "用來計算建議倉位與槓桿。")
float  riskPct   = input.float(2.0, "每筆風險 %", minval = 0.1, step = 0.5, group = G_RK)
float  maxLev    = input.float(3.0, "槓桿上限", minval = 1, step = 0.5, group = G_RK, tooltip = "依風險算出的倉位超過此槓桿時，倉位縮到上限，實際風險會小於設定。")

color  bullCol   = input.color(#00c853, "做多", inline = "c1", group = G_STY)
color  bearCol   = input.color(#ff1744, "做空", inline = "c1", group = G_STY)
color  slCol     = input.color(#f23645, "移動停損線", inline = "c1", group = G_STY)
string sigSizeIn = input.string("大", "訊號文字大小", options = ["小", "中", "大", "特大"], group = G_STY)
string tblSizeIn = input.string("中", "表格文字大小", options = ["小", "中", "大", "特大"], group = G_STY)

// ─────────────────────────── 函式 ───────────────────────────
toSize(string s) =>
    switch s
        "小" => size.small
        "中" => size.normal
        "大" => size.large
        => size.huge

fmt(float p) =>
    str.tostring(p, format.mintick)

fmtR(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "0.0") + "R"

// 在日線資料上計算 [快線 EMA, 慢線 EMA]；搭配 lookahead 關閉，只拿「已收盤」的日K（與 trend_signals.pine 相同做法）：
//  • 歷史K棒：日K收盤的那一根才換新值，呼叫端再往前取一根 → 整天都是前一根已收盤的日K
//  • 即時K棒：在日線這邊直接取前一根 → 同樣是前一根已收盤的日K
dailyCalc(simple int fastLen, simple int slowLen) =>
    int   o  = barstate.isrealtime ? 1 : 0
    float ef = ta.ema(close, fastLen)
    float es = ta.ema(close, slowLen)
    [ef[o], es[o]]

// ─────────────────────────── 日線趨勢 ───────────────────────────
[dE, dS] = request.security(syminfo.tickerid, tfD, dailyCalc(dFastLen, dSlowLen), lookahead = barmerge.lookahead_off)
int   ro     = barstate.isrealtime ? 0 : 1
float dFast  = dE[ro]
float dSlow  = dS[ro]
bool  dReady = not na(dFast) and not na(dSlow)
int   dDir   = not dReady ? 0 : dFast > dSlow ? 1 : dFast < dSlow ? -1 : 0

// ─────────────────────────── 突破條件 ───────────────────────────
float atr    = ta.atr(atrLen)
float hiN    = ta.highest(high, brkLen)[1]    // 前 N 根（不含本根）最高點
float loN    = ta.lowest(low, brkLen)[1]
float vol    = nz(volume)
float volMA  = ta.sma(vol, volLen)
bool  volOK  = volMA > 0 and vol > volMA * volMult
bool  brkUp  = close > hiN
bool  brkDn  = close < loN
bool  canSig = barstate.isconfirmed

// ─────────────────────────── 持倉模擬（與 trend4h_strategy.pine 相同規則） ───────────────────────────
var int    tDir    = 0       // 1 = 做多中，-1 = 做空中，0 = 觀望
var int    tBar    = 0
var float  tEntry  = na
var float  tRisk   = na      // 1R = 進場到初始停損的距離
var float  tInitSL = na
var float  tStop   = na      // 目前停損（移動停損）
var float  tPeak   = na
var float  tQty    = na
var float  tLev    = na
var float  tRealRk = na
var string lastRes = ""
var int    exitBar = -1

bool   exitNow = false
float  exitPx  = na
string exitWhy = ""
if tDir != 0 and bar_index > tBar
    int   d   = tDir
    float adv = d == 1 ? low : high
    string stopNm = tStop != tInitSL ? "移動停損" : "停損"
    if d * (open - tStop) <= 0
        // 開盤直接跳過停損 → 以開盤價出場
        exitPx  := open
        exitWhy := stopNm
    else if d * (adv - tStop) <= 0
        exitPx  := tStop
        exitWhy := stopNm
    else
        // 收盤後更新移動停損：持倉期間最高價（做空：最低價）回落 3 ATR，只往有利方向移動
        tPeak := d == 1 ? math.max(tPeak, high) : math.min(tPeak, low)
        float tr = tPeak - d * trailAtr * atr
        tStop := d == 1 ? math.max(tStop, tr) : math.min(tStop, tr)
        if canSig and d * (close - tStop) <= 0
            exitPx  := close
            exitWhy := "移動停損"
        else if canSig and dDir == -d
            // 日線 EMA 交叉、方向反轉 → 收盤平倉
            exitPx  := close
            exitWhy := "趨勢反轉"

    if not na(exitPx)
        float r = d * (exitPx - tEntry) / tRisk
        exitNow := true
        exitBar := bar_index
        lastRes := (d == 1 ? "做多 " : "做空 ") + exitWhy + " " + fmtR(r)
        tDir    := 0
        label.new(bar_index, d == 1 ? high : low, "出場 " + fmtR(r), yloc = d == 1 ? yloc.abovebar : yloc.belowbar, style = d == 1 ? label.style_label_down : label.style_label_up, color = color.new(r >= 0 ? bullCol : bearCol, 25), textcolor = color.white, size = size.normal, tooltip = exitWhy + " " + fmt(exitPx))

// ─────────────────────────── 進場訊號 ───────────────────────────
bool canEnter = canSig and tDir == 0 and bar_index != exitBar and atr > 0
bool sigL     = canEnter and dDir == 1 and brkUp and volOK
bool sigS     = canEnter and dDir == -1 and brkDn and volOK

string baseCcy = syminfo.basecurrency != "" ? syminfo.basecurrency : "單位"
if sigL or sigS
    int   d    = sigL ? 1 : -1
    float dist = slAtr * atr
    tDir    := d
    tBar    := bar_index
    tEntry  := close
    tRisk   := dist
    tInitSL := close - d * dist
    tStop   := tInitSL
    tPeak   := close

    // 建議倉位 = 本金 × 風險% ÷ 停損距離；換算槓桿，超過上限就縮倉
    float q   = capital * riskPct / 100 / dist
    float lev = q * close / capital
    if lev > maxLev
        q   := capital * maxLev / close
        lev := maxLev
    tQty    := q
    tLev    := lev
    tRealRk := q * dist / capital * 100

    string tip = "進場 " + fmt(tEntry) + "\n初始停損 " + fmt(tInitSL) + "\n建議倉位 " + str.tostring(tQty, "#.####") + " " + baseCcy + "\n建議槓桿 " + str.tostring(tLev, "0.0") + "x"
    label.new(bar_index, d == 1 ? low : high, d == 1 ? "▲ 做多" : "▼ 做空", yloc = d == 1 ? yloc.belowbar : yloc.abovebar, style = d == 1 ? label.style_label_up : label.style_label_down, color = d == 1 ? bullCol : bearCol, textcolor = color.white, size = toSize(sigSizeIn), tooltip = tip, text_formatting = text.format_bold)

// 目前的移動停損線
plot(tDir != 0 ? tStop : na, "移動停損", color = slCol, style = plot.style_linebr, linewidth = 2)

// ─────────────────────────── 右上角表格 ───────────────────────────
var table tb = table.new(position.top_right, 2, 8, bgcolor = color.new(#131722, 15), frame_color = color.new(#787b86, 40), frame_width = 1, border_color = color.new(#787b86, 75), border_width = 1)

dirColor(int d) =>
    d == 1 ? bullCol : d == -1 ? bearCol : color.silver

setRow(int r, string k, string v, color c) =>
    string sz = toSize(tblSizeIn)
    tb.cell(0, r, k, text_color = color.white, text_halign = text.align_left, text_size = sz)
    tb.cell(1, r, v, text_color = c, text_halign = text.align_left, text_size = sz)

if barstate.islast
    bool live = tDir != 0
    setRow(0, "4H 趨勢突破", syminfo.ticker + " · " + timeframe.period, color.white)
    string dTxt = not dReady ? "資料不足" : (dDir == 1 ? "多頭（只做多）" : dDir == -1 ? "空頭（只做空）" : "持平") + "　EMA" + str.tostring(dFastLen) + " " + fmt(dFast) + " / EMA" + str.tostring(dSlowLen) + " " + fmt(dSlow)
    setRow(1, "日線趨勢", dTxt, dirColor(dDir))
    string posTxt = live ? (tDir == 1 ? "▲ 做多" : "▼ 做空") + "（浮動 " + fmtR(tDir * (close - tEntry) / tRisk) + "）" : "觀望"
    setRow(2, "目前持倉", posTxt, dirColor(tDir))
    setRow(3, "進場價", live ? fmt(tEntry) : "觀望", color.white)
    setRow(4, "移動停損", live ? fmt(tStop) + (tStop != tInitSL ? "" : "（初始停損）") : "觀望", slCol)
    setRow(5, "建議倉位", live ? str.tostring(tQty, "#.####") + " " + baseCcy + "（≈ " + str.tostring(tQty * tEntry, "#,##0") + " " + syminfo.currency + "）" : "觀望", color.white)
    setRow(6, "建議槓桿", live ? str.tostring(tLev, "0.0") + "x（上限 " + str.tostring(maxLev) + "x，風險 " + str.tostring(tRealRk, "0.0") + "%）" : "觀望", color.white)
    setRow(7, "上一筆", lastRes != "" ? lastRes : "—", color.silver)

// ─────────────────────────── 警報 ───────────────────────────
alertcondition(sigL, "做多", "{{ticker}} {{interval}}：▲ 做多，收盤 {{close}}")
alertcondition(sigS, "做空", "{{ticker}} {{interval}}：▼ 做空，收盤 {{close}}")
alertcondition(exitNow, "出場", "{{ticker}} {{interval}}：出場（停損 / 移動停損 / 趨勢反轉），價格 {{close}}")
